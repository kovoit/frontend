# URL de l'API Django REST Framework
VITE_API_URL=http://localhost:8000/api/v1
# true = réponses simulées par MSW (aucun backend requis, `npm run dev` uniquement : ignoré au build)
VITE_USE_MOCKS=false
# true = active l'écran du journal des transactions (option portefeuille du PRD)
VITE_FEATURE_WALLET=false
